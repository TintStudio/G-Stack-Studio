{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/reseller", "destination": "/trusted-reseller", "permanent": true },
    { "source": "/lifetime", "destination": "/lifetime-deals", "permanent": true },
    { "source": "/deals", "destination": "/lifetime-deals", "permanent": true },
    { "source": "/partner", "destination": "/reseller-program", "permanent": true },
    { "source": "/partners", "destination": "/reseller-program", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(trusted-reseller|trusted-reseller.html|reseller|reseller.html|api/.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ]
}
